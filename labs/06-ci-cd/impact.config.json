{
  "$comment": "Topic 6: test suites and the files they test. `rules` add dependencies that imports can't see (lab step 2).",
  "suites": {
    "unit": {
      "tests": "app/test/*.test.js"
    },
    "foundations": {
      "tests": "labs/01-foundations/tests/*.test.js"
    },
    "test-design": {
      "tests": "labs/02-test-design/tests/*.test.js"
    },
    "unit-component": {
      "tests": "labs/03-unit-component/tests/*.test.js"
    },
    "contract": {
      "tests": "labs/04-integration-contract/tests/*.test.js"
    },
    "api": {
      "tests": "labs/04-integration-contract/api/tests/*.spec.js"
    },
    "e2e": {
      "tests": "labs/05-ui-e2e/e2e/tests/*.spec.js"
    }
  },
  "rules": [
    {
      "suite": "e2e",
      "when": [
        "app/**",
        "services/**"
      ],
      "why": "Playwright starts the app and drives it over HTTP; no imports to follow"
    },
    {
      "suite": "api",
      "when": [
        "app/**"
      ],
      "why": "the API suite starts the shop through playwright.config.js"
    },
    {
      "suite": "e2e",
      "when": [
        "playwright.config.js",
        "labs/05-ui-e2e/e2e/**"
      ],
      "why": "the suite's own config and helpers"
    },
    {
      "suite": "api",
      "when": [
        "playwright.config.js",
        "labs/04-integration-contract/api/**"
      ],
      "why": "the suite's own config and helpers"
    },
    {
      "suite": "unit",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "foundations",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "test-design",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "unit-component",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "contract",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "api",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    },
    {
      "suite": "e2e",
      "when": [
        "package.json",
        "package-lock.json"
      ],
      "why": "dependencies changed: run everything"
    }
  ]
}
