{
  "name": "qa-ai-era-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "QA Engineering in the AI Era - a hands-on workshop with a demo app and runnable labs",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "learn": "node scripts/learn.mjs",
    "learn:doctor": "node scripts/learn.mjs doctor",
    "learn:start": "node scripts/learn.mjs start",
    "learn:check": "node scripts/learn.mjs check",
    "learn:status": "node scripts/learn.mjs status",
    "doctor": "node scripts/doctor.mjs",
    "start": "node app/src/server.js",
    "start:inventory": "node services/inventory/src/server.js",
    "start:all": "node scripts/start-all.mjs",
    "start:buggy": "ASSISTANT_MODE=buggy node app/src/server.js",
    "start:bug-cart": "BUG_MODE=cart node app/src/server.js",
    "test": "playwright test --project=e2e --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "test:flaky": "playwright test --project=flaky --repeat-each=10",
    "ui:brittle": "playwright test --project=brittle",
    "ui:matrix": "playwright test -c labs/05-ui-e2e/playwright.matrix.config.js",
    "test:unit": "node --test \"app/test/*.test.js\"",
    "foundations:test": "node --test \"labs/01-foundations/tests/*.test.js\"",
    "foundations:risks": "node labs/01-foundations/risks.mjs",
    "foundations:bug-hunt": "node labs/01-foundations/bug-hunt.mjs",
    "design:test": "node --test \"labs/02-test-design/tests/*.test.js\"",
    "design:pairwise": "node labs/02-test-design/pairwise.mjs",
    "design:mutants": "node labs/02-test-design/mutants.mjs",
    "unit:test": "node --test \"labs/03-unit-component/tests/*.test.js\"",
    "unit:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"app/src/**\" \"labs/03-unit-component/tests/*.test.js\"",
    "unit:mutate": "stryker run labs/03-unit-component/stryker.config.json",
    "contract:test": "node --test \"labs/04-integration-contract/tests/*.test.js\"",
    "contract:verify": "node labs/04-integration-contract/verify-provider.mjs",
    "eval:llm": "promptfoo eval -c labs/12-ai-in-qa/llm-eval/promptfooconfig.yaml --no-cache",
    "eval:redteam": "promptfoo eval -c labs/12-ai-in-qa/llm-eval/redteam.yaml --no-cache",
    "eval:llm:view": "promptfoo view",
    "perf:smoke": "k6 run labs/08-performance/k6/smoke.js",
    "perf:orders": "k6 run labs/08-performance/k6/orders.js",
    "perf:stress": "k6 run labs/08-performance/k6/stress.js",
    "perf:test": "node --test \"labs/08-performance/tests/*.test.js\"",
    "sec:test": "node --test \"labs/09-security-a11y/tests/*.test.js\"",
    "sec:audit": "node labs/09-security-a11y/audit-triage.mjs",
    "a11y:test": "playwright test --project=a11y",
    "metrics": "python3 labs/11-quality-intelligence/metrics/quality_metrics.py labs/11-quality-intelligence/metrics/data",
    "gate": "node labs/06-ci-cd/quality-gate/gate.mjs",
    "ci:pipeline": "node labs/06-ci-cd/pipeline.mjs",
    "ci:impact": "node labs/06-ci-cd/impact.mjs",
    "ci:test": "node --test \"labs/06-ci-cd/tests/*.test.js\"",
    "data:shared": "node labs/07-env-data/shared-env.mjs",
    "data:test": "node --test \"labs/07-env-data/tests/*.test.js\"",
    "data:generate": "node labs/07-env-data/generate.mjs",
    "data:mask": "node labs/07-env-data/mask.mjs",
    "data:scan": "node labs/07-env-data/pii-scan.mjs",
    "testgen": "node labs/12-ai-in-qa/testgen/generate.mjs",
    "agent": "node labs/12-ai-in-qa/agent/explore.mjs",
    "test:agent-tools": "playwright test --project=agent-tools",
    "docs": "mkdocs serve",
    "test:docs": "playwright test -c playwright.docs.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "promptfoo": "^0.123.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  }
}
