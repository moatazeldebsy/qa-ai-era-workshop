# Copy to .env (git-ignored) and fill in: cp .env.example .env
# Only needed for Topic 12's real-model routes; every lab works without it.
# Variables set in your shell or as a Codespaces secret take priority.
ANTHROPIC_API_KEY=

# Optional: models for the assistant (claude mode), test generation and the agent.
# ASSISTANT_MODEL=claude-opus-5-5
# TESTGEN_MODEL=claude-opus-5-5
# AGENT_MODEL=claude-opus-5-5

# Not read from here on purpose: switch the assistant per command instead,
#   ASSISTANT_MODE=claude npm start
